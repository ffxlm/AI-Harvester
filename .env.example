# ─── Email Provider: Custom Domain via Gmail IMAP Catch-All ───
EMAIL_PROVIDER=imap
GMAIL_BASE_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
CUSTOM_DOMAIN=yourdomain.com

# ─── CAPTCHA Solving (YesCaptcha / 2Captcha) ───
YESCAPTCHA_KEY=your_yescaptcha_client_key

# ─── Registration Settings ───
THREADS=1

# ─── Optional Static Proxy ───
GROK_PROXY=

# ─── 9Router Integration ───
ROUTER_BASE_URL=https://api.yourdomain.com
ROUTER_PASSWORD=your_router_password

# ─── Webshare Rotating Proxy Pool (Recommended) ───
WEBSHARE_API_KEY=your_webshare_api_key
